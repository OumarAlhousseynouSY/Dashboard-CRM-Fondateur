# Dashboard CRM Fondateur — Variables d'environnement
# Copier ce fichier en ".env" et remplir les valeurs.
# NE JAMAIS committer le fichier ".env" réel.

# Base de données SQLite (usage local uniquement)
DATABASE_URL="file:./prisma/crm.db"

# NextAuth.js — Clé secrète de signature des JWT
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET="<remplacer-par-une-cle-generee>"

# NextAuth.js — URL publique de l'application
NEXTAUTH_URL="http://localhost:3000"
