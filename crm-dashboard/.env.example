# Dashboard CRM Fondateur — Variables d'environnement
# Copier ce fichier en ".env" (local) ou configurer dans Vercel pour la production.
# NE JAMAIS committer le fichier ".env" réel.

# Base de données PostgreSQL (Vercel Postgres / Neon)
# Pooled connection (pour Prisma queries)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct connection (pour Prisma migrations)
DIRECT_URL="postgresql://user:password@host-direct/dbname?sslmode=require"

# NextAuth.js — Clé secrète de signature des JWT
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET="<remplacer-par-une-cle-generee>"

# NextAuth.js — URL publique de l'application
# Local : http://localhost:3000
# Production : https://<votre-domaine>.vercel.app
NEXTAUTH_URL="http://localhost:3000"
